# ============================================================
#  Vivado / Xilinx SDK 生成物 —— 不入版本库
#  这些都可由 .xpr + .bd + .xdc + 源码 重新生成
# ============================================================

# ---- Vivado 日志/运行时 ----
*.jou
*.log
*.str
*.backup.*
.Xil/

# ---- Vivado 生成目录 ----
test/test.cache/
test/test.runs/
test/test.sim/
test/test.hw/
test/test.ip_user_files/

# ---- Block Design 生成物（design01.bd 本身保留）----
test/test.srcs/sources_1/bd/design01/ip/
test/test.srcs/sources_1/bd/design01/ipshared/
test/test.srcs/sources_1/bd/design01/synth/
test/test.srcs/sources_1/bd/design01/sim/
test/test.srcs/sources_1/bd/design01/hw_handoff/
test/test.srcs/sources_1/bd/design01/hdl/
test/test.srcs/sources_1/bd/design01/ui/
test/test.srcs/sources_1/bd/design01/*.bxml
test/test.srcs/sources_1/bd/design01/*_ooc.xdc
test/test.srcs/sources_1/bd/mref/

# ---- SDK 生成物（shell/src 里的代码保留）----
test/test.sdk/.metadata/
test/test.sdk/.sdk/
test/test.sdk/webtalk/
test/test.sdk/RemoteSystemsTempFiles/
test/test.sdk/shell_bsp/
test/test.sdk/*_hw_platform_*/
test/test.sdk/**/Debug/

# ---- 编译/实现产物 ----
*.o
*.d
*.elf
*.bit
*.hdf
*.xsa
*.dcp
*.xci

# ---- 备份 ----
*.bak
*.bak_*